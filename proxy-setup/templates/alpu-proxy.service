[Unit]
Description=alpu Hysteria2 return-to-China proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/alpu-proxy
ExecStart=/usr/local/bin/hysteria server -c /opt/alpu-proxy/config.yaml
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
