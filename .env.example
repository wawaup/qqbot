# QQ 开放平台机器人凭证（q.qq.com 申请）
BOT_APPID=your_appid_here
BOT_SECRET=your_secret_here

# 目标QQ群的 openid，多个群用逗号分隔（机器人入群后从日志中获取）
# 留空时不发送补货/新品主动通知
GROUP_OPENIDS=

# 商品说明、封面、详情图变化通知，独立于补货通知
CONTENT_CHANGE_GROUP_OPENIDS=8BCFB82E1F69A44440B64F2766022549
# 私信只能填写 QQ 开放平台 user_openid，不能填写普通 QQ 号
CONTENT_CHANGE_USER_OPENIDS=

# 允许私聊调用 Grok 的店主 user_openid（逗号分隔）。
# 未在此列表中的用户私聊机器人时只会收到自己的 openid 提示，不会调用 LLM。
# 获取方式：先私聊机器人任意内容，日志/回复里会打印 user_openid，再填到这里并重启。
OWNER_USER_OPENIDS=

# Grok（Anthropic 兼容网关）。也可不写，自动读取 monorepo 根目录 .env.local 的 ANTHROPIC_*。
# GROK_API_KEY=
# GROK_API_BASE_URL=https://alpu.asia
# GROK_MODEL=grok-4.5
# GROK_MAX_TOKENS=1024
# GROK_REVIEW_MAX_TOKENS=2500
# GROK_TIMEOUT_SECONDS=60

# 上新审核：是否允许 core 失败时写 shop-navigator overrides（生产务必 false）
REVIEW_APPLY_ENABLED=false
# NAVIGATOR_ROOT=../shop-navigator
# 本地测试接口 POST /api/v1/review/test （无 token 时仅本机可调）
# REVIEW_API_ENABLED=true
# REVIEW_API_TOKEN=

# 商店地址（仅在 INVENTORY_SOURCE=ldxp 时由本地爬虫使用）
SHOP_URL=https://pay.ldxp.cn/shop/manboup

# 库存数据源：shop-core（推荐）或 ldxp
INVENTORY_SOURCE=shop-core
SHOP_CORE_BASE_URL=http://127.0.0.1:18080
SHOP_CORE_INTERNAL_TOKEN=replace-with-shop-core-internal-token
SHOP_CORE_TIMEOUT_SECONDS=15
# core blob 写失败是否禁止只写本地（默认 true，避免恢复后丢更新）
BLOB_FAIL_CLOSED=true

# 本地 status API 是否优先代理 shop-core（推荐 true）
STATUS_API_PROXY_CORE=true

# 扫描间隔（秒）
SCAN_INTERVAL=60

# 商品说明和图片来源差异检查间隔（秒），默认每 10 分钟
CONTENT_CHECK_INTERVAL=600

# 沙盒模式（开发调试用，true=不真实发消息）
SANDBOX=false

# 同一商品两次通知之间的最小间隔（秒），防止反复上架/补货刷屏，默认 15 分钟
# 覆盖新品/上架/补货三种事件，同一商品共用一份冷却
NOTIFY_COOLDOWN=900
