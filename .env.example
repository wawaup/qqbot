# QQ 开放平台机器人凭证（q.qq.com 申请）
BOT_APPID=your_appid_here
BOT_SECRET=your_secret_here

# 目标QQ群的 openid，多个群用逗号分隔（机器人入群后从日志中获取）
# 例如：GROUP_OPENIDS=openid_群A,openid_群B
GROUP_OPENIDS=your_group_openid_here

# 商店地址
SHOP_URL=https://wzyp.cn/shop/manboup

# 扫描间隔（秒）
SCAN_INTERVAL=60

# 沙盒模式（开发调试用，true=不真实发消息）
SANDBOX=false

# 同一商品两次通知之间的最小间隔（秒），防止反复上架/补货刷屏，默认 15 分钟
# 覆盖新品/上架/补货三种事件，同一商品共用一份冷却
NOTIFY_COOLDOWN=900

# Twitter / X 新帖转发（默认监控 https://x.com/wawaup1024）
TWITTER_ENABLED=true
TWITTER_USERNAME=wawaup1024
TWITTER_DISPLAY_NAME=曼波小店资讯
# 扫描间隔（秒），默认 900=15 分钟
TWITTER_SCAN_INTERVAL=900
# 国内服务器必须走代理（本机 Clash 默认 7890），只代理推特，不影响店铺
TWITTER_HTTP_PROXY=http://127.0.0.1:7890
TWITTER_INCLUDE_RETWEETS=true
# false=不转发回复别人的帖（自己的串推仍会转发）
TWITTER_INCLUDE_REPLIES=false
